knitr::opts_chunk$set(echo = TRUE)
x <- 0
y <- 0
for( i in 1:1000 )
{
x[i+1] <- x[i] + rnorm(1)
y[i+1] <- y[i] + rnorm(1)
}
# 1. Load the required libraries
library(ggplot2)
library(gganimate)
install.packages("gganimate")
# 1. Load the required libraries
library(ggplot2)
library(gganimate)
# 2. Run your loop to generate particle positions
set.seed(42) # For reproducibility
x <- 0
y <- 0
for( i in 1:1000 ) {
x[i+1] <- x[i] + rnorm(1)
y[i+1] <- y[i] + rnorm(1)
}
# 3. Restructure the data into a clean data frame for ggplot
particle_data <- data.frame(
step = 1:length(x),
x = x,
y = y
)
# 4. Create the static ggplot tracking the path and the active head
anim_plot <- ggplot(particle_data, aes(x = x, y = y)) +
geom_path(color = "royalblue", alpha = 0.6, linewidth = 0.8) + # Draws the historical path
geom_point(color = "red", size = 3) +                         # Draws the moving particle
theme_minimal() +
labs(
title = "2D Random Walk (Particle Trajectory)",
subtitle = "Step: {frame_along} of 1001",
x = "X Position",
y = "Y Position"
) +
# 5. Apply gganimate transitions
transition_reveal(step)
# 6. Render and save the animation as a GIF
animate(anim_plot, nframes = 200, fps = 20, renderer = gifski_renderer("particle_movement.gif"))
